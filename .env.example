# ==============================================================================
# SSE Tournament Web — Environment Variables
# ==============================================================================

NEXT_PUBLIC_APP_URL=https://sse-tournament-web.vercel.app

# MongoDB Atlas URI — MUST point to the SAME database used by SSE Tournament Bot (bot.py)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sse_tournament_bot?retryWrites=true&w=majority
MONGODB_DB_NAME=sse_tournament_bot

# ==============================================================================
# Central SSE Accounts OAuth 2.1 / OIDC
# Redirect URI to register in SSE Accounts Admin -> OAuth / SSO Apps:
#   https://sse-tournament-web.vercel.app/api/auth/callback
# ==============================================================================
SSE_ACCOUNTS_URL=https://sse-account.vercel.app
NEXT_PUBLIC_SSE_ACCOUNTS_URL=https://sse-account.vercel.app
SSE_OAUTH_CLIENT_ID=your_sse_oauth_client_id
SSE_OAUTH_CLIENT_SECRET=your_sse_oauth_client_secret

# Random 32+ byte secret for AES-256-GCM HttpOnly session cookies
SESSION_SECRET=replace_with_a_long_random_hex_secret_at_least_32_chars

# Optional comma-separated Discord IDs with global tournament admin override
ADMIN_DISCORD_IDS=

# Ecosystem Links
NEXT_PUBLIC_NEXUS_URL=https://sse-nexus.vercel.app
NEXT_PUBLIC_BOT_INVITE_URL=
NEXT_PUBLIC_SUPPORT_SERVER_INVITE=
