# 1. MongoDB (Same database used by bot.py: sse_tournament_bot)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sse_tournament_bot?retryWrites=true&w=majority"
MONGODB_DB_NAME="sse_tournament_bot"

# 2. Better Auth Core
BETTER_AUTH_SECRET="replace-with-a-32-char-random-secret-key"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. SSE Nexus OAuth 2.0 / OIDC Integration
# Whitelist these Callback URIs in SSE Nexus -> Admin -> OAuth Clients:
#   https://your-tournament-domain.vercel.app/api/auth/callback/sse-nexus
#   http://localhost:3000/api/auth/callback/sse-nexus
NEXUS_BASE_URL="https://sse-nexus.vercel.app"
NEXUS_OAUTH_CLIENT_ID="your-sse-nexus-oauth-client-id"
NEXUS_OAUTH_CLIENT_SECRET="your-sse-nexus-oauth-client-secret"
# Optional explicit overrides (defaults derive from NEXUS_BASE_URL):
# NEXUS_OAUTH_DISCOVERY_URL="https://sse-nexus.vercel.app/.well-known/openid-configuration"
# NEXUS_OAUTH_AUTHORIZATION_URL="https://sse-nexus.vercel.app/api/auth/oauth2/authorize"
# NEXUS_OAUTH_TOKEN_URL="https://sse-nexus.vercel.app/api/auth/oauth2/token"
# NEXUS_OAUTH_USERINFO_URL="https://sse-nexus.vercel.app/api/auth/oauth2/userinfo"
NEXUS_OAUTH_SCOPES="openid profile email"

# 4. Discord Guild Default & Global Bot Admins (comma-separated Discord User IDs)
DEFAULT_GUILD_ID=""
BOT_ADMIN_DISCORD_IDS=""
